  "items": [
    {
      "source": "Invokes the next <a href=\"api/CallAdvisor.html\" title=\"interface in org.springframework.ai.chat.client.advisor.api\"><code>CallAdvisor</code></a> in the <a href=\"api/CallAdvisorChain.html\" title=\"interface in org.springframework.ai.chat.client.advisor.api\"><code>CallAdvisorChain</code></a> with the given\nrequest.",
      "translation": "调用 <a href=\"api/CallAdvisor.html\" title=\"org.springframework.ai.chat.client.advisor.api 中的接口\"><code>CallAdvisor</code></a> 链中的下一个 <a href=\"api/CallAdvisorChain.html\" title=\"org.springframework.ai.chat.client.advisor.api 中的接口\"><code>CallAdvisorChain</code></a>，使用给定的请求。",
      "count": 2
    },
    {
      "source": "Invokes the next <a href=\"api/StreamAdvisor.html\" title=\"interface in org.springframework.ai.chat.client.advisor.api\"><code>StreamAdvisor</code></a> in the <a href=\"api/StreamAdvisorChain.html\" title=\"interface in org.springframework.ai.chat.client.advisor.api\"><code>StreamAdvisorChain</code></a> with the\ngiven request.",
      "translation": "调用 <a href=\"api/StreamAdvisor.html\" title=\"org.springframework.ai.chat.client.advisor.api 中的接口\"><code>StreamAdvisor</code></a> 中的下一个 <a href=\"api/StreamAdvisorChain.html\" title=\"org.springframework.ai.chat.client.advisor.api 中的接口\"><code>StreamAdvisorChain</code></a>，并传入给定的请求。",
      "count": 2
    },
    {
      "source": "Returns the list of all the <a href=\"api/CallAdvisor.html\" title=\"interface in org.springframework.ai.chat.client.advisor.api\"><code>CallAdvisor</code></a> instances included in this chain at\nthe time of its creation.",
      "translation": "返回在创建此链时包含的所有<a href=\"api/CallAdvisor.html\" title=\"org.springframework.ai.chat.client.advisor.api 中的接口\"><code>CallAdvisor</code></a>实例的列表。",
      "count": 2
    },
    {
      "source": "Returns the list of all the <a href=\"api/StreamAdvisor.html\" title=\"interface in org.springframework.ai.chat.client.advisor.api\"><code>StreamAdvisor</code></a> instances included in this chain\nat the time of its creation.",
      "translation": "返回在创建此链时包含的所有<a href=\"api/StreamAdvisor.html\" title=\"org.springframework.ai.chat.client.advisor.api 中的接口\"><code>StreamAdvisor</code></a>实例的列表。",
      "count": 2
    },
    {
      "source": "Returns a new <a href=\"api/BaseAdvisorChain.Builder.html\" title=\"interface in org.springframework.ai.chat.client.advisor.api\"><code>BaseAdvisorChain.Builder</code></a> initialized with this chain's advisors and\nconfiguration, allowing it to be selectively modified before building a new chain.",
      "translation": "返回一个新的 <a href=\"api/BaseAdvisorChain.Builder.html\" title=\"interface in org.springframework.ai.chat.client.advisor.api\"><code>BaseAdvisorChain.Builder</code></a>，该构建器已使用此链的顾问和配置进行初始化，允许在构建新链之前对其进行选择性修改。",
      "count": 2
    },
    {
      "source": "Creates a new CallAdvisorChain copy that contains all advisors after the specified\nadvisor.",
      "translation": "创建一个包含指定顾问之后所有顾问的新 CallAdvisorChain 副本。",
      "count": 2
    },
    {
      "source": "Creates a new StreamAdvisorChain copy that contains all advisors after the\nspecified advisor.",
      "translation": "创建一个包含指定顾问之后所有顾问的新 StreamAdvisorChain 副本。",
      "count": 2
    },
