    {
      "source": "Build the <a href=\"../chat/prompt/ChatOptions.html\" title=\"interface in org.springframework.ai.chat.prompt\"><code>ChatOptions</code></a>.",
      "translation": "构建<a href=\"../chat/prompt/ChatOptions.html\" title=\"org.springframework.ai.chat.prompt 中的接口\"><code>ChatOptions</code></a>。",
      "count": 2
    },
    {
      "source": "Mutate this builder by taking all <code>other</code>'s values that are non-null,\nretaining <code>this</code> other values.",
      "translation": "通过保留所有非空的 `<code>other</code>` 值，同时保持 `<code>this</code>` 的其他值，来变异此构建器。",
      "count": 2
    },
    {
      "source": "Convenience method to set the effort level for the model's response.",
      "translation": "设置模型响应努力程度的便捷方法。",
      "count": 2
    },
    {
      "source": "Sets the geographic region for inference processing.",
      "translation": "设置推理处理的地域。",
      "count": 2
    },
    {
      "source": "Sets the output configuration for controlling response format and effort.",
      "translation": "设置输出配置以控制响应格式和努力程度。",
      "count": 2
    },
    {
      "source": "Sets the service tier for capacity routing.",
      "translation": "设置容量路由的服务层级。",
      "count": 2
    },
    {
      "source": "Convenience method to let Claude adaptively decide whether to think.",
      "translation": "一种便捷方法，让 Claude 自适应地决定是否进行思考。",
      "count": 2
    },
    {
      "source": "Convenience method to let Claude adaptively decide whether to think, with a\ndisplay setting.",
      "translation": "一种便捷方法，让 Claude 能够自适应地决定是否进行思考，并配备显示设置。",
      "count": 2
    },
    {
      "source": "Convenience method to explicitly disable thinking.",
      "translation": "显式禁用思考的便捷方法。",
      "count": 2
    },
    {
      "source": "Convenience method to enable thinking with a specific budget in tokens.",
      "translation": "一种便捷方法，用于在特定 token 预算下启用思考。",
      "count": 2
    },
    {
      "source": "Convenience method to enable thinking with a specific budget and display\nsetting.",
      "translation": "启用特定预算和显示设置以进行思考的便捷方法。",
      "count": 2
    },
    {
      "source": "Enables Anthropic's built-in web search tool with the given configuration.",
      "translation": "启用 Anthropic 内置的网络搜索工具，并使用给定的配置。",
      "count": 2
    },
    {
      "source": "<code>budgetTokens</code> - the thinking budget (must be &gt;= 1024 and &lt; maxTokens)",
      "translation": "`budgetTokens` - 思考预算（必须 >= 1024 且 < maxTokens）",
      "count": 2
    },
    {
      "source": "<code>display</code> - controls how thinking content appears in the response\n(SUMMARIZED or OMITTED)",
      "translation": "<code>display</code> - 控制思考内容在响应中的显示方式（SUMMARIZED 或 OMITTED）",
